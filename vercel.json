{
  "version": 2,
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/extract",       "destination": "/api/extract"       },
    { "source": "/api/get-stream",    "destination": "/api/get-stream"    },
    { "source": "/api/proxy",         "destination": "/api/proxy"         },
    { "source": "/api/multi-stream",  "destination": "/api/multi-stream"  },
    { "source": "/api/nuvio-stream",  "destination": "/api/nuvio-stream"  },
    { "source": "/api/download",      "destination": "/api/download"      },
    { "source": "/(.*)",              "destination": "/index.html"        }
  ]
}
